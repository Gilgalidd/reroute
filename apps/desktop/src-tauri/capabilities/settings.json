{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window may read and write the configuration and manage the default-browser registration.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-config",
    "allow-save-config",
    "allow-discover-browsers",
    "allow-test-url",
    "allow-default-browser-status",
    "allow-register-default-browser",
    "allow-import-hurl",
    "allow-app-info"
  ]
}
